{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs2022-x64",
      "displayName": "VS 2022 x64, Release, /MT",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/../build",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Release",
        "ESP_ASAN": "OFF"
      }
    },
    {
      "name": "vs2022-x64-asan",
      "displayName": "VS 2022 x64, Release, /MT, AddressSanitizer (soaks)",
      "inherits": "vs2022-x64",
      "binaryDir": "${sourceDir}/../build-asan",
      "cacheVariables": {
        "ESP_ASAN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "vs2022-x64",
      "configuration": "Release"
    },
    {
      "name": "release-asan",
      "configurePreset": "vs2022-x64-asan",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "vs2022-x64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 120
      }
    },
    {
      "name": "release-asan",
      "configurePreset": "vs2022-x64-asan",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 600
      }
    }
  ]
}
